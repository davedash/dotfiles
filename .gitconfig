[user]
name = Dave Dash
email = dd@davedash.com
[color]
diff = auto
status = auto
branch = auto
[core]
excludesfile = /Users/davedash/.dotfiles/.gitignore
editor = cursor --wait
[init]
defaultBranch = main
[alias]
ff = merge --ff-only
ci = commit
co = checkout
fro = !git fetch origin && git rebase origin/main
lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
new = !git fetch origin && git switch origin/main -c # arg1 automatically appended
here = rev-parse --abbrev-ref HEAD
makepr = !git push origin -u $(git rev-parse --abbrev-ref HEAD) $@ && gh pr create && gh pr view --web
makeprf = !git fro && git update-pr && git makepr
sync = !gt sync
[merge]
tool = meld
[github]
user = davedash
[interactive]
singlekey = 1
[push]
	default = current
[hub]
protocol = ssh
[credential]
helper = osxkeychain
[color "diff"]
whitespace = red reverse
[filter "lfs"]
clean = git-lfs clean -- %f
smudge = git-lfs smudge -- %f
required = true
process = git-lfs filter-process
[pager]
branch = false
[gpg]
format = ssh
[gpg "ssh"]
program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
gpgsign = true
[user]
signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIs0OkHmJmfH9zrhrCVvxx8nIQKIzbq01AcTs8nZP/4x
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential

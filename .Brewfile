# Everything Homebrew installs on a Mac. install-mac.sh runs
# `brew bundle install` on this file; install.sh links it to ~/.Brewfile so
# `brew bundle --global` finds it from anywhere.

# Command-line tools
brew "atuin"
brew "autossh"
brew "fzf"
brew "gh"
brew "git-extras"
brew "mas"
brew "ripgrep"
brew "starship"
brew "uv"
brew "watch"
brew "wget"
brew "zoxide"

# Apps
cask "1password-cli"
cask "claude"
cask "cleanshot"
cask "docker-desktop"
cask "dropbox"
cask "firefox"
cask "ghostty"
cask "istat-menus"
cask "karabiner-elements"
cask "linear"
cask "notion"
cask "notion-calendar"
cask "raycast"
cask "signal"
cask "slack"
cask "tableplus"
cask "thaw"
cask "visual-studio-code"
# cask "1password"
# cask "skitch"

# Mac App Store
mas "Bear", id: 1091189122
# Dash, Moom
# Cross-platform Git credential storage for multiple hosting providers
cask "git-credential-manager"
